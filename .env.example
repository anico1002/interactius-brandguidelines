# Supabase — Deck Maker persistence + team login (project "brand-guidelines", org Interactius, eu-central-2)
# Copy to .env.local and fill with the project's API credentials (Supabase dashboard → Project Settings → API).
# In production, set these as Netlify environment variables.
# Auth: se entra a /workspace con la cuenta de Google de Interactius. NO hay que crear usuarios a
# mano: el alta es automática al entrar por primera vez, y el hook before-user-created rechaza
# cualquier email que no sea @interactius.com.
#   ⚠ La BAJA sí es manual. Suspender a alguien en Google Admin NO le cierra la sesión: Supabase no
#     revalida contra Google y sus refresh tokens no caducan. Hay que borrar o banear su fila en
#     Supabase → Auth → Users. Ver docs/features/workspace-login-google.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API — used by /api/translate (deck + form translation), /api/rewrite (ReWrit_r,
# the copy rewriter at /workspace/rewrit_r) and IMG_r's style analysis and name proposal
# (/api/images/analyze, /api/images/[id]/analyze, and on saving an edit). Server-side only; never exposed.
ANTHROPIC_API_KEY=

# Gemini (Google) — IMG_r «Editar con IA»: /api/images/[id]/edit (docs/features/img-r.md, fase 2).
# Server-side only; never exposed. The key's Google project needs billing (paid tier): on the free tier
# the image models have a quota of 0 and every edit answers 429. Not needed at build time.
GEMINI_API_KEY=

# Resend — best-effort "aviso automático" email when a client signs a deck (/api/sign).
# All optional: without them the signature is still persisted, just no email is sent.
RESEND_API_KEY=
INTERACTIUS_NOTIFY_EMAIL=        # recipient(s) of the notice; comma-separated
RESEND_FROM=                     # verified sender, e.g. "Interactius <propuestas@interactius.com>"

# Interactius Forms — reuses THIS Supabase project (the deck's) via the vars above.
# Public forms live under /forms; responses land in the `responses` table (RLS: anon INSERT only,
# team members SELECT via their deck session for the CSV export). No extra keys needed.

# Deliv_r — entrega de artefactos a clientes (docs/features/deliv-r.md). SECRETOS de verdad: server-only,
# nunca con prefijo NEXT_PUBLIC_, nunca en el repo. En producción se ponen en Netlify (variables de entorno).
# Sin ellos Deliv_r responde «Servicio no disponible.» (503); el resto del workspace no se entera.
# SUPABASE_SERVICE_ROLE_KEY: salta la RLS. Solo la lee lib/deliv/servidor.ts (repoServicio()), y
#   ese módulo solo lo importan app/clientes/**, las API de accesos y usuarios de /api/deliv_r y
#   app/workspace/deliv_r/usuarios/page.tsx (lib/deliv/__tests__/guardas.test.ts lo vigila).
#   Supabase → Project Settings → API → service_role.
# DELIV_SESSION_SECRET: firma las cookies de sesión de los clientes y los tokens de archivo. Al menos 32
#   caracteres aleatorios (p. ej. `openssl rand -base64 48`). Cambiarlo cierra todas las sesiones.
SUPABASE_SERVICE_ROLE_KEY=
DELIV_SESSION_SECRET=
